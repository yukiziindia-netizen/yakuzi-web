# Backend API base URL (set this in Vercel Environment Variables)
NEXT_PUBLIC_API_BASE_URL=https://www.yukizi.in/api
NEXT_PUBLIC_API_URL=https://www.yukizi.in/api

# Google sign-in. Leave empty and the Google button stays a plain icon.
# OAuth 2.0 "Web application" client id from the Google Cloud console. The
# same value must be set as GOOGLE_CLIENT_ID on the API, or sign-in returns 503.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
